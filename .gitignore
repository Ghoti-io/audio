# Build output
build

# Documentation generated by Doxygen
docs

# Example output files
example.output.*

# Test output (use tests/out rather than writing beside a fixture)
tests/out
tests/data/out

# Pycache files
**/__pycache__

# libFuzzer writes its artifacts beside the binary's working directory, which
# is the repository root when a harness is run by hand. A crash or a slow unit
# is a finding to act on, not a file to commit.
/crash-*
/leak-*
/oom-*
/slow-unit-*
/timeout-*

# Deliberately NOT ignored: tests/data/** and tests/fuzz/corpus/**. Both are
# inputs rather than output, and audio fixtures are the shape most likely to be
# swallowed by a careless rule - a blanket `*.wav`, `*.mp3` or `*.flac` here
# would drop the corpus from every clone but this one while `git status` stayed
# clean. `make check-fixtures` is the gate that refuses to let that happen; do
# not add an extension rule to this file without running it.

# Third-party data fetched by tools/corpus/fetch.sh
/third_party
