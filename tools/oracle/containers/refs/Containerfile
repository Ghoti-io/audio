# The oracle references, pinned, in one image.
#
# **One image rather than one per reference, because the questions interlock.**
# These are not tools that each answer about their own format; they are five
# independent implementations asked the *same* question about the same file,
# and the whole value is in where they disagree. In separate images with
# separate base states, a disagreement would first have to be shown not to be
# the images' fault. One image makes "the reference set" one fact.
#
# ffmpeg      libavformat's RIFF and IFF demuxers. The most widely deployed
#             reader of both formats, and the one whose acceptance is the
#             practical definition of "this file works".
# sox         A wholly separate lineage - it predates ffmpeg and shares no
#             code with it - and the reference that is happiest being asked
#             for a raw sample dump, which is what a byte-exact comparison
#             needs.
# libsndfile  A third parser, reached through python3-soundfile because that
#             is the scriptable spelling. libsndfile is what most audio
#             applications that are not ffmpeg actually use, so it is the one
#             whose acceptance predicts whether a file opens in a DAW.
# mutagen     A fifth reference, and the only one here that exists *for*
#             metadata. Pure Python, no shared code with ffmpeg, and the
#             implementation most taggers are built on - so it is the one
#             whose reading of an ID3v2 frame is the practical definition.
#             Added in phase 3 for a reason worth stating: ffmpeg is what
#             *generates* the tag fixtures, and a reference that both
#             writes the corpus and marks it cannot see a misunderstanding
#             it holds in both directions.
# python3     The standard library's `wave`, a fourth implementation and a
#             pure-Python one, which shares nothing with the three C parsers
#             above. **WAV only**: Python 3.13 removed `aifc` under PEP 594,
#             so there is no stdlib AIFF reader any more and AIFF is scored
#             by the other three.
#
# Everything the build reads is pinned, because an image built here cannot be
# pinned by digest: two builds of one Containerfile are not two copies of one
# image. So the base is pinned by digest and the packages by full apt version,
# and the run-time version check in oracle_env.py is the real guarantee -
# which is why check_pin() runs in both modes.
#
# **The apt pins do not expire, because apt is pointed at a dated snapshot.**
# The Debian archive keeps one version of a package and drops it when an
# update lands, so an exact version resolves today and stops resolving in some
# number of weeks. snapshot.debian.org keeps every version ever published. The
# date is the snapshot the base image records in its own
# /etc/apt/sources.list.d/debian.sources, so every package comes from the
# archive state the base was built against.
#
# Two mechanics taken from the other images in this suite, where they were
# found by getting them wrong: the URL must be **http**, because the slim base
# carries no CA certificates and https fails with a certificate error that
# reads like a network fault - apt verifies by signature either way; and
# Check-Valid-Until has to be off, because a dated Release file is stale by
# design.
#
# The same base digest as every other oracle image in the suite: one base to
# pull, and a glibc the host's own binaries can run against.
FROM docker.io/library/debian@sha256:7792b1f7702a86946cd518db72b6a407302c3e9bc1635634368b878189e8221c

# The snapshot the base records; override only to move every pin at once.
ARG SNAPSHOT=20260918T000000Z

RUN printf 'Types: deb\nURIs: http://snapshot.debian.org/archive/debian/%s\nSuites: trixie trixie-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\n\nTypes: deb\nURIs: http://snapshot.debian.org/archive/debian-security/%s\nSuites: trixie-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\n' \
      "$SNAPSHOT" "$SNAPSHOT" > /etc/apt/sources.list.d/debian.sources \
    && printf 'Acquire::Check-Valid-Until "false";\n' \
      > /etc/apt/apt.conf.d/99snapshot

# libsndfile1 is pinned explicitly as well as python3-soundfile, because it is
# the one that decides an answer: soundfile is a ctypes wrapper and the two
# have separate versions that move independently.
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends \
      ffmpeg=7:7.1.5-0+deb13u1 \
      sox=14.4.2+git20190427-5+b3 \
      python3=3.13.5-1 \
      python3-soundfile=0.13.1-2 \
      libsndfile1=1.2.2-2+deb13u1 \
      python3-mutagen=1.47.0-1 \
    && rm -rf /var/lib/apt/lists/*

# The probes oracle_env.py runs, copied in rather than written with printf
# inside a RUN: font's first draft did that and its escapes reached the file
# literally, which puts a quoting layer between a check and the fact it checks.
COPY ffmpeg-version sox-version libsndfile-version pywave-version \
      mutagen-version /usr/local/bin/
RUN chmod 0755 /usr/local/bin/ffmpeg-version /usr/local/bin/sox-version \
      /usr/local/bin/libsndfile-version /usr/local/bin/pywave-version \
      /usr/local/bin/mutagen-version

# A locale, pinned, because regex lost 1,855 differential rows to an image
# that had none. Nothing here reads a name out of a file yet, but sox and
# ffmpeg both format numbers when asked to describe a file, and a decimal
# comma in a reference's output would be read as a different value.
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 LC_NUMERIC=C

# ffmpeg stamps an encoder string and a creation time into what it writes
# unless told not to; the generator passes the flags, and these make the rest
# of the environment reproducible too.
ENV TZ=UTC SOURCE_DATE_EPOCH=0

ENTRYPOINT []
CMD ["sh", "-c", "ffmpeg-version; sox-version; libsndfile-version; \
pywave-version; mutagen-version"]
